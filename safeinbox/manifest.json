{
  "manifest_version": 3,
  "name": "SafeInbox - Gmail Phishing Detector",
  "version": "1.0.0",
  "description": "Automatically detect phishing emails in Gmail using machine learning",
  
  "permissions": [
    "activeTab",
    "storage", 
    "scripting",
    "tabs"
  ],
  
  "host_permissions": [
    "https://mail.google.com/*",
    "https://gmail.com/*"
  ],
  
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://gmail.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "SafeInbox Phishing Detector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png", 
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://mail.google.com/*", "https://gmail.com/*"]
    }
  ]
}
